# Railway -> pestaña Variables del servicio Postgres -> DATABASE_URL (public networking)
DATABASE_URL="postgresql://postgres:PASSWORD@containers-xxx.railway.app:5432/railway"

# Firma de la cookie de sesión. Generala con: openssl rand -base64 32
AUTH_SECRET="cambiar-esto-por-una-cadena-larga-y-aleatoria"

# Opcional: exige la cabecera x-upload-token en los endpoints de carga
UPLOAD_TOKEN=""
